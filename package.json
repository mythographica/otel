{
	"name": "@mnemonica/otel",
	"version": "0.1.2",
	"description": "Framework-free Node.js core of the mnemonica observability stack — dive hook wiring, OpenTelemetry providers, ALS async-flow tracking, thunderstruck pre-root forensics, unblind error reports",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"require": "./build-cjs/index.js",
			"default": "./build/index.js"
		}
	},
	"files": [
		"build/",
		"build-cjs/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc && tsc -p tsconfig.cjs.json && node scripts/write-cjs-marker.js",
		"build:watch": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build && npm test && node scripts/assert-clean-build.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@mnemonica/dive": "^0.7.0 || ^0.8.0 || ^0.9.0",
		"@opentelemetry/api": "^1.0.0",
		"mnemonica": ">=1.2.7"
	},
	"devDependencies": {
		"@mnemonica/dive": "^0.9.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/sdk-trace-node": "^1.30.1",
		"@types/node": "^20.19.43",
		"mnemonica": "^1.2.8",
		"typescript": "^5.9.3",
		"vitest": "^2.1.9"
	},
	"keywords": [
		"mnemonica",
		"dive",
		"opentelemetry",
		"tracing",
		"observability",
		"async-local-storage",
		"express",
		"fastify",
		"nodejs"
	],
	"author": "went.out@gmail.com",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mythographica/otel.git"
	},
	"bugs": {
		"url": "https://github.com/mythographica/otel/issues"
	},
	"homepage": "https://github.com/mythographica/otel#readme",
	"dependencies": {
		"@mnemonica/dive": "^0.7.0 || ^0.8.0 || ^0.9.0"
	}
}
