{
	"name": "@mnemonica/otel",
	"version": "0.1.5",
	"description": "OpenTelemetry for mnemonica on Node.js: spans for dive's execution flow, and error analysis that ties a failure to its edge and instances",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"require": "./build-cjs/index.js",
			"default": "./build/index.js"
		}
	},
	"files": [
		"build/",
		"build-cjs/",
		"README.md",
		"SKILL.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node scripts/clean-build.js && tsc && tsc -p tsconfig.cjs.json && node scripts/write-cjs-marker.js",
		"build:watch": "tsc --watch",
		"lint": "npx eslint ./src ./test",
		"test": "NODE_OPTIONS=--expose-gc vitest run",
		"test:cov": "NODE_OPTIONS=--expose-gc vitest run --coverage",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build && npm test && node scripts/assert-clean-build.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@mnemonica/dive": "^0.10.3",
		"@opentelemetry/api": "^1.0.0",
		"mnemonica": "^1.3.8"
	},
	"devDependencies": {
		"@mnemonica/dive": "^0.10.3",
		"@mnemonica/lethe": "^0.2.2",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/sdk-trace-node": "^1.30.1",
		"@types/node": "^20.19.43",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"@vitest/coverage-v8": "^2.1.9",
		"ajv": "^8.17.1",
		"eslint": "^9.39.5",
		"eslint-plugin-no-arrow-this": "^1.3.0",
		"globals": "^15.15.0",
		"mnemonica": "^1.3.8",
		"typescript": "^5.9.3",
		"vitest": "^2.1.9"
	},
	"keywords": [
		"mnemonica",
		"dive",
		"opentelemetry",
		"tracing",
		"observability",
		"async-local-storage",
		"nodejs"
	],
	"author": "went.out@gmail.com",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mythographica/otel.git"
	},
	"bugs": {
		"url": "https://github.com/mythographica/otel/issues"
	},
	"homepage": "https://github.com/mythographica/otel#readme"
}
